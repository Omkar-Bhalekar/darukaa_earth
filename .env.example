# Darukaa.Earth Environment Variables
# Copy this file to .env and fill in your values

# Database (Render.com PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/darukaa_earth?sslmode=require

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mapbox
MAPBOX_TOKEN=pk.your-mapbox-token-here

# Frontend URL (for CORS; comma-separated if you have more than one)
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Backend URL (for frontend API calls)
VITE_API_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=pk.your-mapbox-token-here
